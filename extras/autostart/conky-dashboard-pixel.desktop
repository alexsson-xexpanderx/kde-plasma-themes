[Desktop Entry]
Version=1.0
Name=Conky Dashboard (pixel)
Comment=Pixel-art panel for the Retrograde theme: weather, CPU/RAM, network, updates and power
Icon=utilities-system-monitor
# Assumes the repository is at ~/git/kde-plasma-themes; change the path if not.
# The delay is deliberate and cannot be replaced by conky's own --pause.
# configs/dashboard.conf reads _NET_WORKAREA while it is being parsed, so it
# has to run after Plasma has published its panel struts -- and conky applies
# --pause *after* loading the config, which is too late to help.
Exec=sh -c "cd \\$HOME/git/kde-plasma-themes/extras/conky-dashboard-pixel && exec ./start_conky.sh --delay 10"
Terminal=false
Type=Application
StartupNotify=false
Hidden=false
X-GNOME-Autostart-enabled=true
