    $'\e[38;2;210;168;120m▄\e[0m\e[38;2;132;106;83m▀\e[0m\e[38;2;132;106;83m▀\e[0m   \e[38;2;200;180;255m\e[48;2;255;158;192m▀\e[0m\e[38;2;200;180;255m\e[48;2;255;158;192m▀\e[0m\e[38;2;200;180;255m\e[48;2;255;158;192m▀\e[0m\e[38;2;200;180;255m\e[48;2;255;158;192m▀\e[0m\e[38;2;200;180;255m\e[48;2;255;158;192m▀\e[0m\e[38;2;200;180;255m\e[48;2;255;158;192m▀\e[0m\e[38;2;200;180;255m\e[48;2;215;100;154m▀\e[0m\e[38;2;154;128;224m\e[48;2;215;100;154m▀\e[0m\e[38;2;154;128;224m\e[48;2;215;100;154m▀\e[0m\e[38;2;154;128;224m\e[48;2;162;64;126m▀\e[0m\e[38;2;110;85;184m\e[48;2;162;64;126m▀\e[0m\e[38;2;74;55;138m\e[48;2;106;42;104m▀\e[0m\e[38;2;174;101;129m\e[48;2;188;95;114m▀\e[0m   \e[38;2;132;106;83m▀\e[0m\e[38;2;132;106;83m▀\e[0m\e[38;2;210;168;120m▄\e[0m'
    $' \e[38;2;210;168;120m▀\e[0m\e[38;2;210;168;120m▀\e[0m\e[38;2;210;168;120m▄\e[0m\e[38;2;210;168;120m▄\e[0m\e[38;2;246;215;154m▄\e[0m\e[38;2;215;100;154m\e[48;2;246;215;154m▀\e[0m\e[38;2;255;158;192m\e[48;2;255;240;200m▀\e[0m\e[38;2;255;158;192m\e[48;2;255;240;200m▀\e[0m\e[38;2;255;158;192m\e[48;2;255;240;200m▀\e[0m\e[38;2;255;158;192m\e[48;2;255;240;200m▀\e[0m\e[38;2;215;100;154m\e[48;2;255;240;200m▀\e[0m\e[38;2;215;100;154m\e[48;2;255;240;200m▀\e[0m\e[38;2;215;100;154m\e[48;2;255;240;200m▀\e[0m\e[38;2;162;64;126m\e[48;2;255;240;200m▀\e[0m\e[38;2;162;64;126m\e[48;2;255;240;200m▀\e[0m\e[38;2;106;42;104m\e[48;2;255;240;200m▀\e[0m\e[38;2;106;42;104m\e[48;2;255;240;200m▀\e[0m\e[38;2;188;95;114m\e[48;2;246;215;154m▀\e[0m\e[38;2;246;215;154m▄\e[0m\e[38;2;210;168;120m▄\e[0m\e[38;2;210;168;120m▄\e[0m\e[38;2;210;168;120m▀\e[0m\e[38;2;210;168;120m▀\e[0m '
    $'       \e[38;2;246;215;154m\e[48;2;74;55;138m▀\e[0m\e[38;2;246;215;154m\e[48;2;74;55;138m▀\e[0m\e[38;2;246;215;154m\e[48;2;74;55;138m▀\e[0m\e[38;2;246;215;154m\e[48;2;74;55;138m▀\e[0m\e[38;2;246;215;154m\e[48;2;74;55;138m▀\e[0m\e[38;2;246;215;154m\e[48;2;74;55;138m▀\e[0m\e[38;2;246;215;154m\e[48;2;74;55;138m▀\e[0m\e[38;2;246;215;154m\e[48;2;74;55;138m▀\e[0m\e[38;2;246;215;154m\e[48;2;74;55;138m▀\e[0m\e[38;2;246;215;154m\e[48;2;174;101;129m▀\e[0m\e[38;2;246;215;154m\e[48;2;174;101;129m▀\e[0m       '
    $' \e[38;2;195;166;255m▀\e[0m      \e[38;2;74;55;138m▀\e[0m\e[38;2;74;55;138m▀\e[0m\e[38;2;74;55;138m\e[48;2;90;58;98m▀\e[0m\e[38;2;74;55;138m\e[48;2;90;58;98m▀\e[0m\e[38;2;74;55;138m\e[48;2;90;58;98m▀\e[0m\e[38;2;74;55;138m\e[48;2;90;58;98m▀\e[0m\e[38;2;74;55;138m\e[48;2;90;58;98m▀\e[0m\e[38;2;174;101;129m▀\e[0m\e[38;2;174;101;129m▀\e[0m        '
    $'                      \e[38;2;139;227;247m▀\e[0m  '
